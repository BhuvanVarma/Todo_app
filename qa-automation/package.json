{
  "name": "pern-todo-qa-automation",
  "version": "1.0.0",
  "description": "Professional Playwright QA Automation Framework for PERN Todo App",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:integration": "playwright test --project=integration",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --project=ui --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "clean:test-data": "node scripts/clean-test-data.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1"
  }
}
